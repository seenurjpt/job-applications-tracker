# Copy to .env.local and fill in. See job-tracker-build-spec.md §2.4.

MONGODB_URI=mongodb://localhost:27017/job-tracker
MONGODB_DB=job-tracker

AUTH_SECRET=                  # openssl rand -base64 32
AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TOKEN_ENCRYPTION_KEY=         # openssl rand -hex 32  (64 hex chars = 32 bytes)

# Anthropic keys are supplied BY THE USER and stored encrypted per account.
# This variable is for local development and eval runs ONLY. It must be unset in
# production — if it is set, a bug that falls back to it will silently bill you.
ANTHROPIC_API_KEY_DEV=

# Default models offered to users. They may override per account.
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DRAFT_MODEL=claude-sonnet-5
